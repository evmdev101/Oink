            plsReserve = uint256(reserve0);
        }
        
        // Price is incReserve / plsReserve (how many INC per 1 PLS)
        // Scale by 1e18 for precision
        return incReserve * 1e18 / plsReserve;
    }

    function getHEXPerPLSPrice() public view returns (uint256) {
        (uint112 reserve0, uint112 reserve1, ) = IUniswapV2Pair(HEX_PLS_PAIR).getReserves();
        
        address token0 = IUniswapV2Pair(HEX_PLS_PAIR).token0();
        
        uint256 hexReserve;
        uint256 plsReserve;
        
        if (token0 == HEX) {
            hexReserve = uint256(reserve0);
            plsReserve = uint256(reserve1);
        } else {
            hexReserve = uint256(reserve1);
