pragma solidity ^0.8.0;







contract buyOink {
	address public constant DTX = 0xFAaC6a85C3e123AB2CF7669B1024f146cFef0b38;
	address public constant wPLS = 0xA1077a294dDE1B09bB078844df40758a5D0f9a27;
    address public constant PLSX = 0x95B303987A60C71504D99Aa1b13B4DA07b0790ab;
    address public constant INC = 0x2fa878Ab3F87CC1C9737Fc071108F904c0B0C95d;
    address public constant HEX = 0x2b591e99afE9f32eAA6214f7B7629768c40Eeb39;
    address public immutable votingCreditContract = 0xCF14DbcfFA6E99A444539aBbc9aE273a7bb5d75A;

    uint256 public constant minimumPrice = 1e14;

    address public constant OINK_PLS_PAIR = 0xEf9Ea3d72e28c7140481209190601C085027D6fE; // Replace with actual pair address
    address public constant PLSX_PLS_PAIR = 0x1b45b9148791d3a104184Cd5DFE5CE57193a3ee9; // Replace with actual pair address
    address public constant INC_PLS_PAIR = 0xf808Bb6265e9Ca27002c0A04562Bf50d4FE37EAA; // Replace with actual pair address
    address public constant HEX_PLS_PAIR = 0xf1F4ee610b2bAbB05C635F726eF8B0C568c8dc65;
    
    uint256 public haltProposalStartingId = 16000000; //arbitrary starting proposal ID

    bool public withdrawalStarted = false;
    uint256 public withdrawalStartedTime = 0;
    bool public canWithdraw = false;
    uint256 public withdrawalStartedCount = 0;

	event BUY(address buyer, address pool, uint256 oinks);
    
	constructor() {}

    function buyWithPLS(uint256 _amount, address _poolInto) external payable {
        require(msg.value == _amount, "msgvalue different from amount!");
        
        address payable targetContract = payable(treasury());
        (bool success, ) = targetContract.call{value: msg.value}("");
        require(success, "Transfer to target contract failed");

        //Get ratio how much our token is worth PLS
        uint256 oinkPerPLS = getOinkPerPLSPrice();
        require(oinkPerPLS >= minimumPrice, "OINK price below minimum");
        
        uint256 _oinks = _amount * priceWithDiscount(_poolInto, oinkPerPLS) / 1e18;
        
        sendTokens(_poolInto, _oinks);
    }

    function buyWithPLSX(uint256 _amount, address _poolInto) external {
        require(IERC20(PLSX).transferFrom(msg.sender, treasury(), _amount));

        uint256 oinkPerPLS = getOinkPerPLSPrice();
        require(oinkPerPLS >= minimumPrice, "OINK price below minimum");
        
        uint256 plsxPerPLS = getPLSXPerPLSPrice();
        require(plsxPerPLS > 0, "Invalid PLSX/PLS price");
        
        // Calculate equivalent PLS value
        uint256 plsEquivalent = _amount * 1e18 / plsxPerPLS;
        
        // Calculate OINK tokens with discount applied
        uint256 _oinks = plsEquivalent * priceWithDiscount(_poolInto, oinkPerPLS) / 1e18;

        sendTokens(_poolInto, _oinks);
    }

    function buyWithINC(uint256 _amount, address _poolInto) external {
        require(IERC20(INC).transferFrom(msg.sender, treasury(), _amount));

        uint256 oinkPerPLS = getOinkPerPLSPrice();
        require(oinkPerPLS >= minimumPrice, "OINK price below minimum");
        
        uint256 incPerPLS = getINCPerPLSPrice();
        require(incPerPLS > 0, "Invalid INC/PLS price");
        
        // Calculate equivalent PLS value
        uint256 plsEquivalent = _amount * 1e18 / incPerPLS;
        
        // Calculate OINK tokens with discount applied
        uint256 _oinks = plsEquivalent * priceWithDiscount(_poolInto, oinkPerPLS) / 1e18;

        sendTokens(_poolInto, _oinks);
    }

    function buyWithHEX(uint256 _amount, address _poolInto) external {
        require(IERC20(HEX).transferFrom(msg.sender, treasury(), _amount));

        uint256 oinkPerPLS = getOinkPerPLSPrice();
        require(oinkPerPLS >= minimumPrice, "OINK price below minimum");
        
        uint256 hexPerPLS = getHEXPerPLSPrice();
        require(hexPerPLS > 0, "Invalid INC/PLS price");
        
        // Calculate equivalent PLS value
        uint256 plsEquivalent = _amount * 1e10 * 1e18 / hexPerPLS;
        
        // Calculate OINK tokens with discount applied
        uint256 _oinks = plsEquivalent * priceWithDiscount(_poolInto, oinkPerPLS) / 1e18;

        sendTokens(_poolInto, _oinks);
    }
	
    function priceWithDiscount(address _poolInto, uint256 _price) public pure returns (uint256) {
        if(_poolInto == 0xf3E82f4123d4262a2baEC25b03652f3932A91739) {
            return _price * 125 / 100;
        } else if(_poolInto == 0x15b51Ece819f3B51ce814de67bB2419660701a3c) {
            return _price * 118 / 100;
        } else if(_poolInto == 0xc0483f1b0dcf601888fFD0d3A44b7124e80DB7D1) {
            return _price * 111 / 100;
        } 
        return _price;
    }

    function sendTokens(address _poolInto, uint256 _oinks) private {
        if(_poolInto == 0xf3E82f4123d4262a2baEC25b03652f3932A91739 || _poolInto == 0x15b51Ece819f3B51ce814de67bB2419660701a3c ||
                 _poolInto == 0xc0483f1b0dcf601888fFD0d3A44b7124e80DB7D1) {
                    IacPool(_poolInto).giftDeposit(_oinks, msg.sender, 0);
                 } else {
                    require(IERC20(DTX).transfer(msg.sender, _oinks));
                 }
        emit BUY(msg.sender, _poolInto, _oinks);
    }
	
    // Get price of OINK in terms of PLS from Uniswap V2 pair
    function getOinkPerPLSPrice() public view returns (uint256) {
        (uint112 reserve0, uint112 reserve1, ) = IUniswapV2Pair(OINK_PLS_PAIR).getReserves();
        
        address token0 = IUniswapV2Pair(OINK_PLS_PAIR).token0();
        
        uint256 oinkReserve;
        uint256 plsReserve;
        
        if (token0 == DTX) {
            oinkReserve = uint256(reserve0);
            plsReserve = uint256(reserve1);
        } else {
            oinkReserve = uint256(reserve1);
            plsReserve = uint256(reserve0);
        }
        
        // Price is oinkReserve / plsReserve (how many OINK per 1 PLS)
        // Scale by 1e18 for precision
        return oinkReserve * 1e18 / plsReserve;
    }
    
    // Get price of PLSX in terms of PLS from Uniswap V2 pair
    function getPLSXPerPLSPrice() public view returns (uint256) {
        (uint112 reserve0, uint112 reserve1, ) = IUniswapV2Pair(PLSX_PLS_PAIR).getReserves();
        
        address token0 = IUniswapV2Pair(PLSX_PLS_PAIR).token0();
        
        uint256 plsxReserve;
        uint256 plsReserve;
        
        if (token0 == PLSX) {
            plsxReserve = uint256(reserve0);
            plsReserve = uint256(reserve1);
        } else {
            plsxReserve = uint256(reserve1);
            plsReserve = uint256(reserve0);
        }
        
        // Price is plsxReserve / plsReserve (how many PLSX per 1 PLS)
        // Scale by 1e18 for precision
        return plsxReserve * 1e18 / plsReserve;
    }
    
    // Get price of INC in terms of PLS from Uniswap V2 pair
    function getINCPerPLSPrice() public view returns (uint256) {
        (uint112 reserve0, uint112 reserve1, ) = IUniswapV2Pair(INC_PLS_PAIR).getReserves();
        
        address token0 = IUniswapV2Pair(INC_PLS_PAIR).token0();
        
        uint256 incReserve;
        uint256 plsReserve;
        
        if (token0 == INC) {
            incReserve = uint256(reserve0);
